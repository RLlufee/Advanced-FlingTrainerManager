{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Advanced-FlingTrainerManager",
  "version": "0.2.3",
  "identifier": "com.flingtrainer.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Advanced FlingTrainerManager",
        "width": 1080,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data: blob:; connect-src 'self' ipc: http://ipc.localhost https://flingtrainer.com https://*.steamstatic.com https://images.unsplash.com; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/fling_translations.db"
    ]
  }
}
